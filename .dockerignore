# Dependency & build artifacts (di-install/di-build ulang di dalam image)
/vendor
/node_modules
/public/build
/public/hot

# Storage runtime (jangan ikut ke image)
/storage/*.key
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*

# Environment & secrets
.env
.env.*
!.env.example

